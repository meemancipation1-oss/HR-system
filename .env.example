# LLM Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# LLM-as-Judge 评估模型（可选，默认与 LLM_MODEL 相同；建议用更强的模型避免自评自偏差）
# JUDGE_MODEL=deepseek-chat

# Embedding（本地: sentence-transformers/all-MiniLM-L6-v2，远程: text-embedding-3-small）
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data Paths
HR_DATA_DIR=../SynData_1w
VECTOR_DB_DIR=./data/chroma_db

# Agent Configuration
MAX_RETRIES=3
TEMPERATURE=0.1

